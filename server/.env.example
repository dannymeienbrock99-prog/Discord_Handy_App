# Eigene HTTPS-Adresse und DNS-Hostname. Keine URL-Unterpfade verwenden.
PUBLIC_HOST=modstempel.example.com
PUBLIC_ORIGIN=https://modstempel.example.com
ACME_EMAIL=admin@example.com

# Aus DERSELBEN eigenen Discord-Anwendung im Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Konto-ID (Snowflake) des einzigen Betreibers, NICHT Server- oder Rollen-ID.
# In Discord: Einstellungen > Erweitert > Entwicklermodus; eigenes Konto > ID kopieren.
# Ohne diese ID ist die Freigabe geschlossen. Bestehende Nutzer werden nicht automatisch zugelassen.
OWNER_DISCORD_ID=

# Zusätzlich im Discord Developer Portal als Redirect URI eintragen:
# https://DEIN-HOST/portal/callback (neben https://DEIN-HOST/oauth/callback).
# Private, bereits signierte APK. NIEMALS im Ordner public ablegen.
APK_VERSION=2.2.0
APK_PATH=./releases/Crazy_Batto-Discord-App-2.2.0.apk

# Einmalig mit: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Dieses Geheimnis gemeinsam mit der privaten Datenbank sichern und beibehalten.
TOKEN_ENCRYPTION_KEY=

# Für direkten Node-Betrieb. Docker Compose überschreibt diese drei Werte.
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
TRUST_PROXY=0
